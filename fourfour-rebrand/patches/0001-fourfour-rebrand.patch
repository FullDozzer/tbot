 private typealias SGControllerEntry = SGItemListUIEntry<SGControllerSection, SGBoolSetting, SGSliderSetting, SGOneFromManySetting, SGDisclosureLink, AnyHashable>
 
+// MARK: fourfour branding
+// Фон верхней плашки (navigation bar) экрана настроек fourfour.
+private let SGFourFourPlaqueBackgroundColor = UIColor(rgb: 0x000000)
+
+// Локальная копия темы только для экрана настроек fourfour:
+// верхняя плашка — чёрная (#000000), текст и кнопки — белые.
+// Все остальные цвета берутся из активной темы без изменений,
+// поэтому остальной интерфейс Telegram/Swiftgram не затрагивается.
+private func sgFourFourSettingsPresentationData(_ presentationData: PresentationData) -> ItemListPresentationData {
+    let theme = presentationData.theme
+    let navigationBar = theme.rootController.navigationBar.withUpdated(
+        buttonColor: .white,
+        primaryTextColor: .white,
+        secondaryTextColor: .white,
+        blurredBackgroundColor: SGFourFourPlaqueBackgroundColor,
+        opaqueBackgroundColor: SGFourFourPlaqueBackgroundColor,
+        separatorColor: SGFourFourPlaqueBackgroundColor
+    )
+    let chatInputPanel = theme.chat.inputPanel.withUpdated(
+        panelControlColor: .white,
+        panelControlDisabledColor: UIColor.white.withAlphaComponent(0.5),
+        panelControlAccentColor: .white
+    )
+    let brandedTheme = PresentationTheme(
+        name: theme.name,
+        index: theme.index,
+        referenceTheme: theme.referenceTheme,
+        overallDarkAppearance: theme.overallDarkAppearance,
+        intro: theme.intro,
+        passcode: theme.passcode,
+        rootController: theme.rootController.withUpdated(
+            statusBarStyle: .white,
+            navigationBar: navigationBar
+        ),
+        list: theme.list,
+        chatList: theme.chatList,
+        chat: theme.chat.withUpdated(inputPanel: chatInputPanel),
+        actionSheet: theme.actionSheet,
+        contextMenu: theme.contextMenu,
+        inAppNotification: theme.inAppNotification,
+        chart: theme.chart,
+        preview: theme.preview
+    )
+    return ItemListPresentationData(presentationData.withUpdated(theme: brandedTheme))
+}
+
